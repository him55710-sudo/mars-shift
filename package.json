{
  "name": "mars-shift",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/package_navcam_assets.mjs",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "science": "node scripts/run_science_analysis.mjs",
    "data:hazards": "python scripts/acquire_hazard_data.py",
    "science:hazards": "node scripts/run_hazard_analysis.mjs",
    "science:sand": "node scripts/run_sand_analysis.mjs",
    "data:storms": "python scripts/acquire_storm_data.py",
    "data:storm-boundaries": "python scripts/acquire_storm_boundaries.py",
    "science:storms": "node scripts/run_storm_analysis.mjs",
    "science:hazards:dev": "node scripts/run_hazard_v2.mjs dev --final-round",
    "science:hazards:test": "node scripts/run_hazard_v2.mjs test --final-round",
    "science:navigation": "node scripts/run_navigation_analysis.mjs",
    "science:rover": "node scripts/run_rover_analysis.mjs",
    "science:encounters": "node scripts/run_encounters_v7.mjs",
    "science:encounters:geometry": "node scripts/run_geometry_v7.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  },
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": "24.x"
  }
}
